# Copy to .env and fill in. `run_local.sh` sources this file.

# --- API (NaviGator proxy: required for gpt-5.4) ---
GPT_NAVIGATOR_API_KEY=your-navigator-key
GPT_NAVIGATOR_BASE_URL=https://api.ai.it.ufl.edu/v1
OPENAI_API_KEY=your-navigator-key
OPENAI_BASE_URL=https://api.ai.it.ufl.edu/v1

# For direct OpenAI instead (works only with real OpenAI model ids, e.g. gpt-4o):
#   OPENAI_API_KEY=your-openai-key
#   leave OPENAI_BASE_URL unset

# Optional: only needed to use --llm claude (rate_with_claude in src/llm_rater.py).
# Requires the `anthropic` package (see requirements.txt).
#   ANTHROPIC_API_KEY=your-anthropic-key

# --- Data paths ---
# Directory of CK clips named 0001.mp4, 0002.mp4, ...
CK_VIDEOS_DIR=/path/to/ckvideo
# Optional: human ratings CSV (only needed if you let the loader enumerate all
# clips; not needed when you pass --videos explicitly). The ground-truth CSV
# used by the analysis step ships inside this bundle.
CK_HUMAN_RATINGS_CSV=/path/to/CowenKeltnerEmotionalVideos.csv

# Still-image VA datasets
NAPS_IMAGES_DIR=/blue/mzding/yujunchen/projects/data/NAPS_H/NAPS_H
IAPS_IMAGES_DIR=/blue/mzding/yujunchen/projects/data/IAPS1182/IAPS1182
OASIS_IMAGES_DIR=/blue/mzding/yujunchen/projects/data/OASIS/images
